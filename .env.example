# Provider API keys
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Provider modes: hybrid (default) or openai
LLM_PROVIDER_MODE=hybrid
EMBEDDING_PROVIDER_MODE=hybrid

# Hybrid LLM routing (Google primary + fallback, OpenAI backup)
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
LLM_BACKUP_MODEL=gpt-4.1-mini

# OpenAI-only LLM routing (used when LLM_PROVIDER_MODE=openai)
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_LLM_FALLBACK_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=700

# Embedding routing (Google primary, OpenAI fallback)
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_INPUT_PRICE_PER_1M=0.15
OPENAI_OUTPUT_PRICE_PER_1M=0.60

# App runtime metadata
APP_ENV=dev
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Data paths
GLOSSARY_DATA_PATH=data/glossary_en.jsonl
GUIDES_DATA_PATH=data/guides_en.jsonl
FAQ_DATA_PATH=data/faq_en.jsonl

# RAG controls
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Mock test defaults
MOCK_TEST_DEFAULT_MINUTES=15

# Monitoring / dashboard (local stack)
PROMETHEUS_PORT=8000
START_PROMETHEUS_HTTP_SERVER=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Grafana Cloud remote_write (for GCP + Alloy deployment)
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_API_KEY=

# Input safety guardrails
ENABLE_INPUT_GUARD=true
MAX_INPUT_CHARS=3000
# Optional comma-separated overrides (leave empty to use secure defaults in code)
BLOCKED_WORDS=
INJECTION_PATTERNS=
