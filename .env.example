# OpenAI settings (required only if any provider is set to openai)
OPENAI_API_KEY=

# Model/runtime settings
LLM_MODEL=claude-haiku-4-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=700

# Provider controls
LLM_PROVIDER=vertex_claude
EMBEDDING_PROVIDER=vertex

# Vertex AI settings
VERTEX_PROJECT_ID=project-1b553d65-984a-4d5b-a4f
VERTEX_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005

# App runtime metadata
APP_ENV=dev
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Data paths
GLOSSARY_DATA_PATH=data/glossary_en.jsonl
GUIDES_DATA_PATH=data/guides_en.jsonl
FAQ_DATA_PATH=data/faq_en.jsonl

# RAG controls
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Mock test defaults
MOCK_TEST_DEFAULT_MINUTES=15

# Monitoring / dashboard (local stack)
PROMETHEUS_PORT=8000
START_PROMETHEUS_HTTP_SERVER=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Grafana Cloud remote_write (for GCP + Alloy deployment)
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_API_KEY=

# Input safety guardrails
ENABLE_INPUT_GUARD=true
MAX_INPUT_CHARS=3000
# Optional comma-separated overrides (leave empty to use secure defaults in code)
BLOCKED_WORDS=
INJECTION_PATTERNS=
